{
  "name": "@dw/handout",
  "version": "0.0.0",
  "private": true,
  "description": "The Handout: a Record's Explainer pages checked, sanitized and assembled into one self-contained HTML file. The contract between dw, the renderer host and the builder; the builder and the Handout's controller",
  "type": "module",
  "exports": {
    ".": "./src/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build -c vite.controller.config.ts && vite build"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
