#!/bin/bash
# dw-check — the plumbing of scripts/dw, case by case, without the HUD or WebKit: narration, records,
# resume, audience markers and what `dw handout` checks before its renderer starts. Every case calls
# dw's own functions (everything but its dispatch) under a scratch DW_HOME and DW_CONFIG; the functions
# that reach the HUD, the network or the renderer are replaced by stand-ins.
#
# Why it exists: dw is bash 3.2 under set -u, and a function broken by an edit still passes bash -n
# and shellcheck: a block pasted into cmd_say stopped every `dw say` with "src: unbound variable".
# These cases run the functions. dw uses BSD stat and date, so scripts/check runs this file on macOS.
#
# Usage: scripts/dw-check   exit 0 when every case passed
set -u
cd "$(dirname "$0")/.." || exit 1
failures=0
pass() { printf '  ✓ %s\n' "$1"; }
fail() { printf '  ✗ %s\n' "$1"; failures=$((failures + 1)); }

# Every path below is made under it: without one the run stops before anything is written
if ! scratch=$(mktemp -d) || [ ! -d "$scratch" ]; then
  echo "dw-check: could not make a scratch folder" >&2
  exit 1
fi
# Pages a case made immutable (chflags uchg) are made removable again first
trap 'chflags -R nouchg "$scratch" 2>/dev/null; chmod -R u+w "$scratch" 2>/dev/null; rm -rf "$scratch"' EXIT
export DW_HOME="$scratch/state" DW_CONFIG="$scratch/config" DW_CHECK_SEEN="$scratch/seen-input.json"
RECORDS="$DW_CONFIG/walkthroughs"
mkdir -p "$DW_HOME" "$RECORDS"
# dw's own functions (everything but its dispatch)
sed '/^case "\${1:-}" in$/,$d' scripts/dw > "$scratch/dwlib"

# The renderer's stand-in: it keeps the input.json dw wrote and ends the export with a failure
cat > "$scratch/fake-renderer" <<'EOF'
#!/bin/bash
cp "$1" "$DW_CHECK_SEEN"
printf '{"v":1,"ok":false,"diagnostics":[{"code":"HANDOUT_RENDERER","message":"stand-in renderer"}]}'
EOF
chmod +x "$scratch/fake-renderer"
# The renderer a case runs (in_dw): the stand-in above unless the case names another
renderer="$scratch/fake-renderer"
# The libraries a case's dw verifies (in_dw): none unless the case names some
vendor_list=""

# Hold the lock file LOCK as another dw would, in the background, until the caller kills the holder;
# prints the holder's process id once the lock is held
hold_like_another_dw() {
  rm -f "$scratch/held"
  # Its output goes nowhere: a $(…) around this function waits for every holder of its pipe
  perl -MFcntl=:flock -e 'open(my $f, ">>", $ARGV[0]) or exit 1; flock($f, LOCK_EX) or exit 1; open(my $r, ">", $ARGV[1]); close $r; sleep 60' "$1" "$scratch/held" > /dev/null 2>&1 &
  local holder=$! waited=0
  until [ -e "$scratch/held" ] || [ "$waited" -ge 100 ]; do sleep 0.05; waited=$((waited + 1)); done
  printf '%s' "$holder"
}

# Hold the lock file LOCK as another dw would, in the background; a second after it is held, make LINK
# a link to a file that does not exist, and let the lock go. A dw started meanwhile has looked at the
# folder before the link is there and waits for the lock: it takes the lock with the link in place.
# Prints the holder's process id once the lock is held
hold_then_leave_link() {
  rm -f "$scratch/held"
  # Its output goes nowhere: a $(…) around this function waits for every holder of its pipe
  perl -MFcntl=:flock -e 'open(my $f, ">>", $ARGV[0]) or exit 1; flock($f, LOCK_EX) or exit 1; open(my $r, ">", $ARGV[1]); close $r; sleep 1; symlink($ARGV[2], $ARGV[3])' "$1" "$scratch/held" "$scratch/no-such-page.md" "$2" > /dev/null 2>&1 &
  local holder=$! waited=0
  until [ -e "$scratch/held" ] || [ "$waited" -ge 100 ]; do sleep 0.05; waited=$((waited + 1)); done
  printf '%s' "$holder"
}

# Make DW_CHECK_LINK a link to a file that does not exist while an export reads its pages: dw looks up
# each page's section then (record_section), after it has listed the pages and before it lists them
# again. Then "$@"
link_while_reading() {
  # dw's own record_section under another name, called by the stand-in that makes the link first
  eval "$(declare -f record_section | sed '1s/^record_section/dw_record_section/')"
  record_section() { ln -s "$scratch/no-such-page.md" "$DW_CHECK_LINK" 2>/dev/null; dw_record_section "$@"; }
  "$@"
}

# Run "$@" (a dw function and its arguments) in a subshell with dw's functions loaded; the HUD, the
# network, the renderer and waiting are stand-ins. Both output streams in $out, the exit status in $code
in_dw() {
  out=$(
    {
      # shellcheck source=/dev/null
      source "$scratch/dwlib"
      gate() { :; }
      note_owner() { :; }
      ensure_hud() { :; }
      explain_vendor() { :; }
      handout_renderer() { :; }
      sleep() { :; }
      # Read by dw's functions sourced above: no library to verify, the renderer's stand-in
      # shellcheck disable=SC2034
      EXPLAIN_VENDOR="$vendor_list"
      # shellcheck disable=SC2034
      HANDOUT_BIN="$renderer"
      "$@"
    } 2>&1
  )
  code=$?
}

# date as dw names an archive folder, fixed at one second; every other use of date as it is. Then "$@"
fixed_clock() {
  date() { if [ "${1:-}" = "+%Y%m%d-%H%M%S" ]; then printf '20261128-010000\n'; else command date "$@"; fi; }
  "$@"
}

# A Record NAME under RECORDS with a journal, two pages and their sections; prints its folder
two_page_record() {
  local dir="$RECORDS/$1"
  mkdir -p "$dir/pages"
  printf '# 記録：%s\n' "$1" > "$dir/journal.md"
  printf '# 一枚目\n\n本文 1\n' > "$dir/pages/01-一枚目.md"
  printf '# 二枚目\n\n本文 2\n' > "$dir/pages/02-二枚目.md"
  printf '1\t\n2\t\n' > "$dir/pages/sections.tsv"
  printf '%s' "$dir"
}

# The names in folder DIR, hidden ones too, one per line, but the lock file every writer leaves there
files_but_lock() {
  local entry
  for entry in "$1"/* "$1"/.[!.]*; do
    [ -e "$entry" ] && [ "$(basename "$entry")" != .dw-lock ] && basename "$entry"
  done
  return 0
}

# The first bytes of every Handout (packages/handout/src/contract.ts HANDOUT_HEAD)
handout_head() { printf '<!doctype html>\n<html lang="ja">\n<head>\n<meta charset="utf-8">\n<meta name="dw-handout" content="1">'; }

echo "== narration"
in_dw cmd_say "準備ができました"
if [ "$code" = 0 ] && [ "$(cat "$DW_HOME/status.txt" 2>/dev/null)" = "準備ができました" ]; then
  pass "dw say puts the line on the status bar"
else
  fail "dw say puts the line on the status bar (exit $code: $out)"
fi

dir=$(two_page_record steps)
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw cmd_step "設定"
if [ "$code" = 0 ] && [ "$(cat "$DW_HOME/status.txt" 2>/dev/null)" = "【設定】 設定" ] && grep -qx '## 設定' "$dir/journal.md"; then
  pass "dw step starts a section: the status bar prefix and a journal heading"
else
  fail "dw step starts a section (exit $code: $out)"
fi
rm -f "$DW_HOME/record_dir" "$DW_HOME/step"

echo "== records"
dir="$RECORDS/hundred"
mkdir -p "$dir/pages"
for n in 100 2 99 1 10; do printf '# p%s\n' "$n" > "$dir/pages/$(printf '%02d' "$n")-p$n.md"; done
in_dw record_pages "$dir"
if [ "$(printf '%s\n' "$out" | cut -f1 | tr '\n' ' ')" = "1 2 10 99 100 " ]; then
  pass "pages are listed in reading order up to page 100 (numbers, not text)"
else
  fail "page order: $out"
fi

dir="$RECORDS/numbers"
mkdir -p "$dir/pages"
printf '# p\n' > "$dir/pages/00-zero.md"
printf '# p\n' > "$dir/pages/1234567890-long.md"
printf '# p\n' > "$dir/pages/01-one.md"
in_dw record_pages "$dir"
if [ "$(printf '%s\n' "$out" | cut -f1 | tr '\n' ' ')" = "1 " ]; then
  pass "a page numbered 0 or with more than nine digits is no page: the lists skip it"
else
  fail "page numbers dw never writes: $out"
fi

defaults="$scratch/config-defaults/walkthroughs"
mkdir -p "$defaults/older" "$defaults/newer" "$defaults/pointed" "$defaults/running"
for name in older newer pointed running; do printf '# 記録：%s\n' "$name" > "$defaults/$name/journal.md"; done
touch -t 202611010000 "$defaults/older/journal.md" "$defaults/pointed/journal.md" "$defaults/running/journal.md"
touch -t 202611020000 "$defaults/newer/journal.md"
rm -f "$DW_HOME/record_dir" "$DW_HOME/last_record"
DW_CONFIG="$scratch/config-defaults" in_dw handout_default_record
newest="$out"
printf '%s' "$defaults/pointed" > "$DW_HOME/last_record"
DW_CONFIG="$scratch/config-defaults" in_dw handout_default_record
pointed="$out"
printf '%s' "$defaults/running" > "$DW_HOME/record_dir"
DW_CONFIG="$scratch/config-defaults" in_dw handout_default_record
running="$out"
if [ "$newest" = "$defaults/newer" ] && [ "$pointed" = "$defaults/pointed" ] && [ "$running" = "$defaults/running" ]; then
  pass "dw handout without a name exports the running record, else the last one, else the newest journal"
else
  fail "default record: newest=$newest pointed=$pointed running=$running"
fi
rm -f "$DW_HOME/record_dir" "$DW_HOME/last_record"

dir="$RECORDS/tabs"
mkdir -p "$dir/pages"
printf '# 記録：tabs\n' > "$dir/journal.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '本文\n' > "$scratch/body.md"
in_dw record_page 1 $'タブ\tの題' "$scratch/body.md" $'タブ\tの\n題' quiet
if [ "$(cat "$dir/pages/sections.tsv")" = "$(printf '1\t\tタブ の 題')" ] && [ -f "$dir/pages/01-タブ-の題.md" ]; then
  pass "a title with a tab or a line break keeps one sections.tsv row per page and a file name without them"
else
  fail "tab normalization: $(cat "$dir/pages/sections.tsv") / $(ls "$dir/pages")"
fi

# A page resumed under another spelling of its number (1-, 001-) is replaced, not kept beside the new
# one: dw handout reads both as page 1 and would refuse the Record
dir=$(two_page_record spelt)
mv "$dir/pages/01-一枚目.md" "$dir/pages/001-一枚目.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 直した一枚目\n' > "$scratch/fixed.md"
in_dw record_page 1 "直した一枚目" "$scratch/fixed.md" "" quiet
if [ "$code" = 0 ] && [ "$(find "$dir/pages" -maxdepth 1 -name '*-*.md' | grep -c '/0*1-')" = 1 ] && [ -f "$dir/pages/01-直した一枚目.md" ]; then
  pass "correcting a page spelt 001- replaces it: one file of number 1 stays"
else
  fail "page number spelling: exit $code: $out / $(ls "$dir/pages" | tr '\n' ' ')"
fi
# A folder at the page's new file name would take the page inside it; the save stops instead
dir=$(two_page_record dir-at-name)
mkdir "$dir/pages/01-新しい題.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw record_page 1 "新しい題" "$scratch/fixed.md" "" quiet
if [ "$code" != 0 ] && grep -q 'is not a plain file' <<< "$out" && [ -f "$dir/pages/01-一枚目.md" ] && [ -z "$(ls -A "$dir/pages/01-新しい題.md")" ]; then
  pass "a folder at the page's file name stops the save and the earlier page stays"
else
  fail "folder at the page name: exit $code: $out"
fi
# A page number given zero-padded (--page 01) is page 1: a new title replaces 01-一枚目.md, never
# leaving it beside the new file
dir=$(two_page_record padded)
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw record_page 01 "直した題" "$scratch/fixed.md" "" quiet
if [ "$code" = 0 ] && [ ! -e "$dir/pages/01-一枚目.md" ] && [ -f "$dir/pages/01-直した題.md" ]; then
  pass "a page number given as 01 replaces page 1 under its new title"
else
  fail "zero-padded page number: exit $code: $out / $(ls "$dir/pages" | tr '\n' ' ')"
fi
# handbook.md rebuilt keeps its own permissions (a private one stays 0600), and one that is a link to
# a folder is replaced by the file itself: nothing is written into that folder
dir=$(two_page_record private-handbook)
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 古い\n' > "$dir/handbook.md"
chmod 600 "$dir/handbook.md"
in_dw record_page 1 "一枚目" "$scratch/fixed.md" "" quiet
mode=$(perl -e 'printf "%o", (stat shift)[2] & 07777' "$dir/handbook.md")
mkdir "$scratch/handbook-folder"
rm -f "$dir/handbook.md"
ln -s "$scratch/handbook-folder" "$dir/handbook.md"
in_dw record_page 2 "二枚目" "$scratch/fixed.md" "" quiet
if [ "$mode" = 600 ] && [ "$code" = 0 ] && [ -f "$dir/handbook.md" ] && [ ! -L "$dir/handbook.md" ] \
  && [ -z "$(ls -A "$scratch/handbook-folder")" ]; then
  pass "a rebuilt handbook.md keeps its permissions, and a link to a folder in its place is replaced, the folder untouched"
else
  fail "handbook replacement: mode $mode, exit $code: $out / $(ls -A "$scratch/handbook-folder" | tr '\n' ' ')"
fi
# A rebuilt handbook.md keeps an access list (ACL) set on it: written in place, never a new file
dir=$(two_page_record acl-handbook)
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 古い\n' > "$dir/handbook.md"
chmod +a "everyone deny read" "$dir/handbook.md"
in_dw record_page 1 "一枚目" "$scratch/fixed.md" "" quiet
# ls -le prints the ACL of the one file named (no file name is matched against the pattern)
# shellcheck disable=SC2010
acl=$(ls -le "$dir/handbook.md" | grep -c 'everyone deny read')
chmod -a "everyone deny read" "$dir/handbook.md"
if [ "$code" = 0 ] && [ "$acl" = 1 ] && grep -q '直した' "$dir/handbook.md"; then
  pass "a rebuilt handbook.md keeps the access list set on it"
else
  fail "handbook ACL: exit $code, acl entries $acl: $out"
fi
# A pages/ that is a link to another Record's pages is never written or cleared through
other=$(two_page_record link-target)
dir="$RECORDS/linked-writer"
mkdir -p "$dir"
printf '# 記録：linked-writer\n' > "$dir/journal.md"
ln -s "$other/pages" "$dir/pages"
printf '%s' "$dir" > "$DW_HOME/record_dir"
before=$(cat "$other/pages/01-一枚目.md")
in_dw record_page 1 "上書き" "$scratch/fixed.md" "" quiet
saved="$code/$out"
in_dw record_clear
if [[ "$saved" == 1/*"is a symbolic link"* ]] && [ "$code" = 1 ] && grep -q 'is a symbolic link' <<< "$out" \
  && [ "$(cat "$other/pages/01-一枚目.md")" = "$before" ] && [ ! -e "$other/pages/01-上書き.md" ] \
  && [ -z "$(find "$other/pages" -maxdepth 1 -name 'cleared-*')" ]; then
  pass "a pages/ that is a link to another Record is refused by saves and clears, the other Record untouched"
else
  fail "linked pages/ writer (save $saved; clear $code: $out): $(ls "$other/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

# A journal.md that is a link is not written through: the line is not written, its target unchanged
dir=$(two_page_record linked-journal-line)
printf '{"kept": true}\n' > "$scratch/journal-target.json"
rm -f "$dir/journal.md"
ln -s "$scratch/journal-target.json" "$dir/journal.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw journal "一行"
if [ "$code" = 0 ] && grep -q 'not a plain file: the journal line was not written' <<< "$out" \
  && [ "$(cat "$scratch/journal-target.json")" = '{"kept": true}' ]; then
  pass "a journal.md that is a link takes no line: a warning, and its target unchanged"
else
  fail "linked journal line (exit $code: $out): $(cat "$scratch/journal-target.json")"
fi
rm -f "$DW_HOME/record_dir"

# A clear stops before removing anything when pages/ holds an entry its archive could not keep: a page
# file with a line break in its name (older records), or a link whose file is gone. It says the
# entry's page number and kind, never its name (a page's title, which nothing has scanned)
dir=$(two_page_record odd-newline)
printf '# 古い\n' > "$dir/pages/"$'03-古い\n題.md'
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw record_clear
newline="$code/$out"
rm -f "$dir/pages/"$'03-古い\n題.md'
ln -s "$scratch/no-such-page.md" "$dir/pages/03-消えた.md"
in_dw record_clear
if [[ "$newline" == 1/*"page 3 in pages/ is a file with a line break in its name"*"nothing was removed"* ]] \
  && [[ "$newline" != *古い* ]] \
  && [ "$code" = 1 ] && grep -q 'page 3 in pages/ is a link whose file is gone' <<< "$out" && ! grep -q '消えた' <<< "$out" \
  && [ -f "$dir/pages/01-一枚目.md" ] && [ -f "$dir/pages/02-二枚目.md" ] \
  && [ -z "$(find "$dir/pages" -maxdepth 1 -name 'cleared-*')" ]; then
  pass "a clear stops, nothing removed, when a page file has a line break in its name or is a link whose file is gone, said by number"
else
  fail "clear with an odd page entry (newline $newline; dangling $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"
# An entry put there while the clear waits for the record's lock is seen too: the clear looks again
# once it holds the lock, where it takes the list of pages to archive
dir=$(two_page_record odd-late)
printf '%s' "$dir" > "$DW_HOME/record_dir"
holder=$(hold_then_leave_link "$dir/pages/.dw-lock" "$dir/pages/03-後から.md")
in_dw record_clear
wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q 'page 3 in pages/ is a link whose file is gone' <<< "$out" \
  && [ -f "$dir/pages/01-一枚目.md" ] && [ -f "$dir/pages/02-二枚目.md" ] \
  && [ -z "$(find "$dir/pages" -maxdepth 1 -name 'cleared-*')" ]; then
  pass "an entry that is no page file, put there while a clear waits for the record's lock, stops it: nothing removed"
else
  fail "odd entry during the wait for the lock (exit $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"
# Only the numbers the lists read as pages count: an entry numbered 0 or written with more than nine
# digits (even a ten-digit spelling of 1) is no page, whatever it is, and a folder is said as one
dir="$RECORDS/odd-numbers"
mkdir -p "$dir/pages"
ln -s "$scratch/no-such-page.md" "$dir/pages/0-零.md"
ln -s "$scratch/no-such-page.md" "$dir/pages/0000000001-長い.md"
in_dw record_odd_entry "$dir"
none="$code/$out"
mkdir "$dir/pages/07-フォルダ.md"
in_dw record_odd_entry "$dir"
if [ "$none" = "1/" ] && [ "$code" = 0 ] && [ "$out" = "$(printf '7\ta folder')" ]; then
  pass "an entry numbered 0 or past nine digits is no page entry; a folder under a page's name is one, said as page 7"
else
  fail "odd entry numbers (none $none; folder $code: $out)"
fi

# A pipe where the lock file goes would hold dw before any timeout: it is refused at once
dir=$(two_page_record piped-lock)
mkfifo "$dir/pages/.dw-lock"
printf '%s' "$dir" > "$DW_HOME/record_dir"
# Watchdog: a dw that opens the pipe would wait for a reader forever; after 10 s open the
# reading end (nonblocking) so such a dw goes on and this case fails instead of hanging
perl -MFcntl -e 'sleep 10; sysopen(my $h, $ARGV[0], O_RDONLY | O_NONBLOCK); sleep 2' \
  "$dir/pages/.dw-lock" > /dev/null 2>&1 &
watchdog=$!
in_dw record_page 1 "一枚目" "$scratch/fixed.md" "" quiet
kill "$watchdog" 2> /dev/null
wait "$watchdog" 2> /dev/null
if [ "$code" != 0 ] && grep -q 'is not a plain file (dw makes it)' <<< "$out"; then
  pass "a pipe at the lock file's name is refused at once, never waited on"
else
  fail "piped lock: exit $code: $out"
fi
rm -f "$DW_HOME/record_dir"

dir="$RECORDS/controls"
mkdir -p "$dir/pages"
printf '# 記録：controls\n' > "$dir/journal.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw record_page 2 $'端末\033[31m赤\a' "$scratch/body.md" "" quiet
controlled=""
for name in "$dir"/pages/*; do
  case "$(basename "$name")" in *[[:cntrl:]]*) controlled="$controlled $(basename "$name" | od -c | head -1)" ;; esac
done
if [ -f "$dir/pages/02-端末[31m赤.md" ] && [ -z "$controlled" ]; then
  pass "a title with terminal control characters gives a file name without them"
else
  fail "control characters in a file name:$controlled"
fi

holder=$(hold_like_another_dw "$dir/pages/.dw-lock")
before=$(ls "$dir/pages")
started=$(date +%s)
DW_LOCK_WAIT=0 in_dw record_page 3 "待つ" "$scratch/body.md" "" quiet
if [ "$code" = 1 ] && grep -q 'another dw' <<< "$out" && [ $(($(date +%s) - started)) -le 2 ]; then
  pass "DW_LOCK_WAIT=0 gives up at once when another writer holds the lock, never waiting for it"
else
  fail "no-wait lock (exit $code after $(($(date +%s) - started)) s): $out"
fi
DW_LOCK_WAIT=1 in_dw record_page 3 "待つ" "$scratch/body.md" "" quiet
held_code="$code" held_out="$out" held_after=$(ls "$dir/pages")
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
in_dw record_page 3 "待つ" "$scratch/body.md" "" quiet
if [ "$held_code" = 1 ] && grep -q 'another dw' <<< "$held_out" && [ "$held_after" = "$before" ] \
  && [ "$code" = 0 ] && [ -f "$dir/pages/03-待つ.md" ]; then
  pass "a page write waits for another writer's lock and touches nothing; once that writer is gone the lock is free"
else
  fail "record lock (held exit $held_code: $held_out / after exit $code): $(ls -a "$dir/pages" | tr '\n' ' ')"
fi

printf '1\t\n' > "$dir/pages/sections.tsv"
mkdir "$dir/pages/sections.tsv.part.$$"
before=$(ls "$dir/pages")
in_dw record_page 5 "書けない索引" "$scratch/body.md" "" quiet
after=$(ls "$dir/pages")
rmdir "$dir/pages/sections.tsv.part.$$"
if [ "$code" = 1 ] && [ "$after" = "$before" ] && [ "$(cat "$dir/pages/sections.tsv")" = "$(printf '1\t')" ]; then
  pass "a sections.tsv that cannot be written stops a page write before the page changes"
else
  fail "unwritable sections index (exit $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
chmod 000 "$dir/pages/sections.tsv"
before=$(ls "$dir/pages")
in_dw record_page 4 "新しい" "$scratch/body.md" "" quiet
chmod 644 "$dir/pages/sections.tsv"
if [ "$code" = 1 ] && grep -q 'cannot be read' <<< "$out" && [ "$(ls "$dir/pages")" = "$before" ] \
  && [ "$(cat "$dir/pages/sections.tsv")" = "$(printf '1\t')" ]; then
  pass "a sections.tsv that cannot be read stops a page write before the page or the other rows change"
else
  fail "unreadable sections.tsv (exit $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
dir="$RECORDS/tabs"
printf '%s' "$dir" > "$DW_HOME/record_dir"

mkdir -p "$DW_HOME/explain"
printf '{"current":1,"pages":[{"n":1,"title":"題","step":"","file":"pages/001.html"}]}\n' > "$DW_HOME/explain/index.json"
in_dw record_page 1 "題" "$scratch/body.md" "" quiet
in_dw record_section "$dir" 1
if [ "$(cat "$dir/pages/sections.tsv")" = "$(printf '1\t')" ] && [ -z "$out" ]; then
  pass "a page shown before the first dw step has no section name (not a blank)"
else
  fail "section before the first step: [$(cat "$dir/pages/sections.tsv")] [$out]"
fi
printf '1\t \n' > "$dir/pages/sections.tsv"
in_dw record_section "$dir" 1
if [ -z "$out" ]; then pass "a record whose section is a lone space reads as no section"; else fail "lone-space section: [$out]"; fi
rm -rf "$DW_HOME/explain"

dir="$RECORDS/keep"
mkdir -p "$dir/pages"
printf '# 記録：keep\n' > "$dir/journal.md"
printf '旧\n' > "$dir/pages/01-旧.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '新\n' > "$scratch/unreadable.md"
chmod 000 "$scratch/unreadable.md"
in_dw record_page 1 "新" "$scratch/unreadable.md" "" quiet
chmod 644 "$scratch/unreadable.md"
if [ "$code" != 0 ] && [ -f "$dir/pages/01-旧.md" ] && [ ! -e "$dir/pages/01-新.md" ]; then
  pass "a page that cannot be written keeps its earlier version in the record"
else
  fail "failed page write (exit $code): $(ls "$dir/pages")"
fi

dir="$RECORDS/quiet-clear"
mkdir -p "$dir/pages"
printf '# 記録：quiet-clear\n' > "$dir/journal.md"
printf '1\t章\n' > "$dir/pages/sections.tsv"
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw record_clear
if [ "$code" = 0 ] && [ -z "$(find "$dir/pages" -name 'cleared-*')" ] && [ "$(cat "$dir/pages/sections.tsv")" = "$(printf '1\t章')" ]; then
  pass "dw explain --clear on a record without pages makes no archive and leaves its sections"
else
  fail "clear without pages (exit $code): $(ls "$dir/pages")"
fi

dir="$RECORDS/twice"
mkdir -p "$dir/pages"
printf '# 記録：twice\n' > "$dir/journal.md"
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '一回目\n' > "$dir/pages/01-a.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
in_dw fixed_clock record_clear
printf '二回目\n' > "$dir/pages/01-a.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
in_dw fixed_clock record_clear
first="$dir/pages/cleared-20261128-010000/01-a.md"
second="$dir/pages/cleared-20261128-010000-1/01-a.md"
if [ "$(cat "$first" 2>/dev/null)" = "一回目" ] && [ "$(cat "$second" 2>/dev/null)" = "二回目" ]; then
  pass "two clears within one second keep two archives: neither overwrites the other"
else
  fail "two clears in one second: $(find "$dir/pages" -type f | sort | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

# A tab before a would-be closing fence is four columns: it closes nothing, and a marker after it is code
printf '```text\n\t```\n<!-- hud-only -->\n```\n' > "$scratch/tab-fence.md"
: > "$scratch/tab-fence.problems"
in_dw explain_filter hud "$scratch/tab-fence.md" "$scratch/tab-fence.problems"
if [ "$code" = 0 ] && grep -q '<!-- hud-only -->' <<< "$out" && [ ! -s "$scratch/tab-fence.problems" ]; then
  pass "a tab before a would-be closing fence counts four columns: the marker after it stays code"
else
  fail "tab before a closing fence (exit $code: $out): $(cat "$scratch/tab-fence.problems")"
fi

echo "== resume"
dir="$RECORDS/resumed"
mkdir -p "$dir/pages"
printf '# 記録：resumed\n' > "$dir/journal.md"
printf '# 一枚目\n\n本文\n' > "$dir/pages/01-一枚目.md"
printf '# 二枚目\n\n<!-- hud-only -->\n閉じていない\n' > "$dir/pages/02-二枚目.md"
printf '1\t\n2\t\n' > "$dir/pages/sections.tsv"
rm -rf "$DW_HOME/explain"
in_dw explain_restore "$dir"
if [ "$(jq -c '[.pages[].n]' "$DW_HOME/explain/index.json" 2>/dev/null)" = "[1,2]" ] \
  && grep -q '解説 2' "$DW_HOME/explain/pages/002.html" 2>/dev/null \
  && grep -q '対応が崩れているため表示できません' "$DW_HOME/explain/pages/002.html"; then
  pass "on resume a page whose markers broke shows a stand-in under its number, saying what is wrong"
else
  fail "stand-in on resume (exit $code: $out): $(cat "$DW_HOME/explain/index.json" 2>/dev/null)"
fi
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 三枚目\n\n本文\n' > "$scratch/third.md"
in_dw cmd_explain "$scratch/third.md"
after_new=$(cat "$dir/pages/02-二枚目.md")
printf '# 二枚目\n\n直した\n' > "$scratch/fixed.md"
in_dw cmd_explain "$scratch/fixed.md" --page 2
if [ -f "$DW_HOME/explain/pages/003.md" ] && grep -q '閉じていない' <<< "$after_new" \
  && grep -q '直した' "$dir/pages/02-二枚目.md" 2>/dev/null; then
  pass "a resumed page whose markers broke keeps its number: a new page becomes 3, and --page 2 repairs it"
else
  fail "resume with a broken page (exit $code: $out): $(ls "$DW_HOME/explain/pages" "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"
rm -rf "$DW_HOME/explain"

dir=$(two_page_record replaced)
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 一枚目\n\n表示中\n' > "$scratch/shown.md"
in_dw cmd_explain "$scratch/shown.md"
cp "$DW_HOME/explain/pages/001.md" "$scratch/shown-before.md" 2>/dev/null
printf '# 差し替え\n' > "$scratch/locked.md"
chmod 000 "$scratch/locked.md"
in_dw cmd_explain "$scratch/locked.md" --page 1
chmod 644 "$scratch/locked.md"
if [ "$code" != 0 ] && [ -s "$scratch/shown-before.md" ] && cmp -s "$DW_HOME/explain/pages/001.md" "$scratch/shown-before.md" \
  && grep -q '表示中' "$dir/pages/01-一枚目.md" 2>/dev/null; then
  pass "a replacement page that cannot be read leaves the page and its recorded copy as they were"
else
  fail "unreadable --page source (exit $code: $out): $(cat "$DW_HOME/explain/pages/001.md" 2>/dev/null)"
fi

# Every name a clear in that second could take is a file already: no archive folder can be made
for tries in '' $(seq 1 99); do : > "$dir/pages/cleared-20261128-010000${tries:+-$tries}"; done
in_dw fixed_clock cmd_explain --clear
if [ "$code" != 0 ] && grep -q 'nothing was removed' <<< "$out" && [ "$(jq '.pages | length' "$DW_HOME/explain/index.json" 2>/dev/null)" = 1 ] \
  && [ -f "$DW_HOME/explain/pages/001.md" ] && [ -f "$dir/pages/01-一枚目.md" ] && [ -f "$dir/pages/02-二枚目.md" ]; then
  pass "a clear whose archive cannot be made keeps every page in the panel and in the record"
else
  fail "failed clear (exit $code: $out): $(ls "$DW_HOME/explain/pages" 2>&1 | tr '\n' ' ')"
fi
rm -f "$dir"/pages/cleared-*
rm -f "$DW_HOME/record_dir"
rm -rf "$DW_HOME/explain"

dir="$RECORDS/marked-title"
mkdir -p "$dir/pages"
printf '# 記録：marked-title\n' > "$dir/journal.md"
printf '# 一枚目\n' > "$dir/pages/01-一枚目.md"
printf '<!-- hud-only -->\n閉じていない\n' > "$dir/pages/02-目印の話.md"
printf '1\t\n2\t\t目印 <!-- hud-only --> の話\n' > "$dir/pages/sections.tsv"
in_dw explain_restore "$dir"
if [ "$(jq '[.pages[].n]' -c "$DW_HOME/explain/index.json" 2>/dev/null)" = "[1,2]" ] && [ -f "$DW_HOME/explain/pages/002.html" ]; then
  pass "a broken page whose given title holds a marker still keeps its number and a stand-in on resume"
else
  fail "stand-in with a marked title (exit $code: $out): $(cat "$DW_HOME/explain/index.json" 2>/dev/null)"
fi
rm -rf "$DW_HOME/explain"

dir=$(two_page_record locked-explain)
printf '%s' "$dir" > "$DW_HOME/record_dir"
mkdir -p "$DW_HOME/explain"
printf '# 待つページ\n' > "$scratch/waiting.md"
holder=$(hold_like_another_dw "$DW_HOME/explain/.dw-lock")
DW_LOCK_WAIT=1 in_dw cmd_explain "$scratch/waiting.md"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
if [ "$code" != 0 ] && grep -q 'another dw' <<< "$out" && [ ! -e "$DW_HOME/explain/pages/001.md" ] \
  && [ "$(ls "$dir/pages" | tr '\n' ' ')" = "01-一枚目.md 02-二枚目.md sections.tsv " ]; then
  pass "a page added while another dw explain holds the explainer waits, then gives up changing nothing"
else
  fail "explainer lock (exit $code: $out): $(ls "$DW_HOME/explain/pages" 2>&1 | tr '\n' ' ')"
fi

holder=$(hold_like_another_dw "$dir/pages/.dw-lock")
DW_LOCK_WAIT=1 in_dw cmd_explain "$scratch/waiting.md" --title "it's"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
retry=$(sed -n 's/.*record it with: dw explain //p' <<< "$out")
if [ "$code" = 1 ] && grep -q 'the record could not keep it' <<< "$out" \
  && [ "$retry" = "'$DW_HOME/explain/pages/001.md' --page 1 --title 'it'\\''s'" ]; then
  pass "a page the record cannot keep is said, with the command that records that page (its title kept)"
else
  fail "record failure after dw explain (exit $code: $out)"
fi
# The command given records the page shown, without adding another to the panel
eval "in_dw cmd_explain $retry"
if [ "$(jq '.pages | length' "$DW_HOME/explain/index.json")" = 1 ] \
  && [ "$(ls "$dir/pages" | tr '\n' ' ')" = "01-it's.md 02-二枚目.md sections.tsv " ]; then
  pass "the retry dw explain gives records page 1 in place: the panel still has one page"
else
  fail "retry of the record (exit $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"
rm -rf "$DW_HOME/explain"

# dw record backfills the pages already shown; one the record cannot keep is said and dw record fails
mkdir -p "$DW_HOME/explain/pages" "$RECORDS/backfill/pages"
printf '{"current":2,"pages":[{"n":1,"title":"一枚目","step":"","file":"pages/001.html"},{"n":2,"title":"二枚目","step":"","file":"pages/002.html"}]}\n' > "$DW_HOME/explain/index.json"
printf '# 一枚目\n' > "$DW_HOME/explain/pages/001.md"
printf '# 二枚目\n' > "$DW_HOME/explain/pages/002.md"
holder=$(hold_like_another_dw "$RECORDS/backfill/pages/.dw-lock")
DW_LOCK_WAIT=0 in_dw cmd_record backfill
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q '^recording: ' <<< "$out" && grep -q 'page(s) 1 2 of the panel could not be saved' <<< "$out"; then
  pass "dw record says which pages shown so far it could not save, and fails"
else
  fail "backfill that cannot save (exit $code: $out)"
fi
in_dw cmd_record backfill
if [ "$code" = 0 ] && [ "$(ls "$RECORDS/backfill/pages" | tr '\n' ' ')" = "01-一枚目.md 02-二枚目.md sections.tsv " ]; then
  pass "dw record again saves the pages it could not save before"
else
  fail "second dw record (exit $code: $out): $(ls "$RECORDS/backfill/pages" | tr '\n' ' ')"
fi

# A page whose row in sections.tsv cannot be saved (the file is locked: readable, not replaceable) is
# not left in the record without it: the record stays as it was, so dw record again saves the page
# with its row instead of skipping it
panel=$(cat "$DW_HOME/explain/index.json")
printf '{"current":3,"pages":[{"n":1,"title":"一枚目","step":"","file":"pages/001.html"},{"n":2,"title":"二枚目","step":"","file":"pages/002.html"},{"n":3,"title":"三枚目の題","step":"後半","file":"pages/003.html"}]}\n' > "$DW_HOME/explain/index.json"
printf '# 三枚目\n' > "$DW_HOME/explain/pages/003.md"
chflags uchg "$RECORDS/backfill/pages/sections.tsv"
in_dw cmd_record backfill
listed=$(ls -A "$RECORDS/backfill/pages" | tr '\n' ' ')
if [ "$code" = 1 ] && grep -q "page 3: its row in the record's sections.tsv could not be saved" <<< "$out" \
  && grep -q 'page(s) 3 of the panel could not be saved' <<< "$out" \
  && [ "$listed" = ".dw-lock 01-一枚目.md 02-二枚目.md sections.tsv " ]; then
  pass "a page whose row in sections.tsv cannot be saved is not kept without it: the record stays as it was"
else
  fail "row that cannot be saved (exit $code: $out): $listed"
fi
# The same for a page shown again under another title: its earlier file comes back
in_dw record_page 1 "新しい題" "$DW_HOME/explain/pages/003.md" "新しい題" quiet
listed=$(ls -A "$RECORDS/backfill/pages" | tr '\n' ' ')
if [ "$code" = 1 ] && [ "$listed" = ".dw-lock 01-一枚目.md 02-二枚目.md sections.tsv " ] \
  && [ "$(cat "$RECORDS/backfill/pages/01-一枚目.md")" = '# 一枚目' ]; then
  pass "a replaced page whose row cannot be saved keeps its earlier file and title"
else
  fail "replaced page whose row cannot be saved (exit $code: $out): $listed"
fi
chflags nouchg "$RECORDS/backfill/pages/sections.tsv"
in_dw cmd_record backfill
if [ "$code" = 0 ] && [ "$(ls "$RECORDS/backfill/pages" | tr '\n' ' ')" = "01-一枚目.md 02-二枚目.md 03-三枚目の題.md sections.tsv " ] \
  && grep -q "^3	後半	三枚目の題$" "$RECORDS/backfill/pages/sections.tsv"; then
  pass "dw record again saves that page with its section and the title it was given"
else
  fail "dw record after the row could be saved (exit $code: $out): $(ls "$RECORDS/backfill/pages" | tr '\n' ' ') / $(cat "$RECORDS/backfill/pages/sections.tsv")"
fi
printf '%s\n' "$panel" > "$DW_HOME/explain/index.json"
rm -f "$DW_HOME/explain/pages/003.md" "$DW_HOME/record_dir"

# A page the record holds under another spelling of its number (001-), edited there, is kept: dw
# record skips it as it skips 01-, and never puts the panel's older copy in its place
mv "$RECORDS/backfill/pages/01-一枚目.md" "$RECORDS/backfill/pages/001-一枚目.md"
printf '# 一枚目（記録で直した）\n' > "$RECORDS/backfill/pages/001-一枚目.md"
in_dw cmd_record backfill
if [ "$code" = 0 ] && [ "$(cat "$RECORDS/backfill/pages/001-一枚目.md" 2>/dev/null)" = '# 一枚目（記録で直した）' ] \
  && [ ! -e "$RECORDS/backfill/pages/01-一枚目.md" ]; then
  pass "dw record keeps a page the record holds as 001-, edited there, and does not replace it with the panel's copy"
else
  fail "dw record over a page spelt 001- (exit $code: $out): $(ls "$RECORDS/backfill/pages" | tr '\n' ' ')"
fi
# A page of an older record whose file name has a line break (record_pages leaves it out) still counts
# as held: dw record never replaces it with the panel's copy
legacy="$RECORDS/backfill/pages/"$'02-古い\n題.md'
mv "$RECORDS/backfill/pages/02-二枚目.md" "$legacy"
printf '# 二枚目（記録で直した）\n' > "$legacy"
in_dw cmd_record backfill
if [ "$code" = 0 ] && [ "$(cat "$legacy" 2>/dev/null)" = '# 二枚目（記録で直した）' ] && [ ! -e "$RECORDS/backfill/pages/02-二枚目.md" ]; then
  pass "dw record keeps a page whose file name has a line break, and does not replace it with the panel's copy"
else
  fail "dw record over a page with a line break in its name (exit $code: $out): $(ls "$RECORDS/backfill/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

# dw record reads the panel's pages under the explainer's lock: while another dw shows a page again
# it saves none (the title it read could be the earlier one), says so and fails
holder=$(hold_like_another_dw "$DW_HOME/explain/.dw-lock")
DW_LOCK_WAIT=0 in_dw cmd_record serial
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q '^recording: ' <<< "$out" && grep -q 'the pages of the panel could not be saved in the record yet' <<< "$out" \
  && [ -z "$(ls "$RECORDS/serial/pages" 2>/dev/null)" ]; then
  pass "dw record while another dw changes the panel saves no page under a title that may be stale, and says so"
else
  fail "backfill under the explainer lock (exit $code: $out): $(ls "$RECORDS/serial/pages" 2>&1 | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

# A panel page with no heading the HUD shows is titled 解説 N by the panel: dw record saves no
# --title for it, so a Handout still names it by its handout-only heading, as after dw explain
panel=$(cat "$DW_HOME/explain/index.json")
printf '{"current":1,"pages":[{"n":1,"title":"解説 1","step":"","file":"pages/001.html"}]}\n' > "$DW_HOME/explain/index.json"
mv "$DW_HOME/explain/pages/001.md" "$scratch/panel-001.md"
printf '<!-- handout-only -->\n# 配布用の題\n<!-- /handout-only -->\n\n本文\n' > "$DW_HOME/explain/pages/001.md"
in_dw cmd_record fallback-title
if [ "$code" = 0 ] && [ "$(cut -f3 "$RECORDS/fallback-title/pages/sections.tsv" 2>/dev/null)" = "" ] \
  && [ "$(cut -f1 "$RECORDS/fallback-title/pages/sections.tsv" 2>/dev/null)" = 1 ]; then
  pass "dw record saves no title for a page the panel named 解説 N for want of a HUD heading"
else
  fail "fallback title saved as --title (exit $code: $out): $(cat "$RECORDS/fallback-title/pages/sections.tsv" 2>&1)"
fi
# A page with no heading at all keeps the panel's title 解説 1 in the Handout (its file is 01-解説-1.md)
dir="$RECORDS/fallback-title"
printf '本文だけ\n' > "$dir/pages/01-解説-1.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
in_dw record_title "$dir" 1 "$dir/pages/01-解説-1.md" handout
if [ "$out" = "解説 1" ]; then
  pass "a page with no heading is titled 解説 1 in the Handout, not by its file name's 解説-1"
else
  fail "headless page title: $out"
fi
mv "$scratch/panel-001.md" "$DW_HOME/explain/pages/001.md"
printf '%s\n' "$panel" > "$DW_HOME/explain/index.json"
rm -f "$DW_HOME/record_dir"

# dw explain --rebuild holds the explainer's lock: a page added meanwhile is never dropped
before=$(cat "$DW_HOME/explain/index.json")
holder=$(hold_like_another_dw "$DW_HOME/explain/.dw-lock")
DW_LOCK_WAIT=0 in_dw explain_rebuild
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q 'another dw' <<< "$out" && [ "$(cat "$DW_HOME/explain/index.json")" = "$before" ] \
  && [ ! -e "$DW_HOME/explain/pages/001.html" ]; then
  pass "dw explain --rebuild while another dw adds a page changes nothing and says so"
else
  fail "rebuild under the explainer lock (exit $code: $out)"
fi
in_dw explain_rebuild
if [ "$code" = 0 ] && [ -f "$DW_HOME/explain/pages/001.html" ] && [ -f "$DW_HOME/explain/pages/002.html" ]; then
  pass "dw explain --rebuild builds every page once the explainer is free"
else
  fail "rebuild (exit $code: $out)"
fi
rm -rf "$DW_HOME/explain"

# A page rewritten under a new title replaces its earlier file; one that cannot be moved leaves all
dir=$(two_page_record immutable-old)
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 新しい題\n' > "$scratch/new-title.md"
chflags uchg "$dir/pages/01-一枚目.md"
before=$(files_but_lock "$dir/pages"; cat "$dir/pages/sections.tsv")
in_dw record_page 1 "新しい題" "$scratch/new-title.md" "" quiet
after=$(files_but_lock "$dir/pages"; cat "$dir/pages/sections.tsv")
chflags nouchg "$dir/pages/01-一枚目.md"
if [ "$code" = 1 ] && grep -q 'could not be replaced' <<< "$out" && [ "$after" = "$before" ]; then
  pass "a rewritten page whose earlier file cannot be removed leaves the record as it was, and says so"
else
  fail "earlier page file that cannot go (exit $code: $out): $after"
fi
in_dw record_page 1 "新しい題" "$scratch/new-title.md" "" quiet
if [ "$code" = 0 ] && [ "$(files_but_lock "$dir/pages" | tr '\n' ' ')" = "01-新しい題.md 02-二枚目.md sections.tsv " ]; then
  pass "a rewritten page under a new title replaces its earlier file, nothing left aside"
else
  fail "page rewritten under a new title (exit $code: $out): $(ls -A "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

# An earlier file whose name nears the 255-character limit of a name (a long title) is replaced
# like any other: the name it is moved aside under stays short
dir=$(two_page_record long-name)
printf '%s' "$dir" > "$DW_HOME/record_dir"
long="01-$(printf 'a%.0s' $(seq 240)).md"
mv "$dir/pages/01-一枚目.md" "$dir/pages/$long"
in_dw record_page 1 "新しい題" "$scratch/new-title.md" "" quiet
if [ "$code" = 0 ] && [ "${#long}" -gt 80 ] && [ "$(files_but_lock "$dir/pages" | tr '\n' ' ')" = "01-新しい題.md 02-二枚目.md sections.tsv " ]; then
  pass "an earlier file with a name near the length limit is replaced too"
else
  fail "earlier file with a long name (exit $code: $out): $(files_but_lock "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"

dir=$(two_page_record uncopyable)
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw cmd_explain "$scratch/waiting.md"
chmod 000 "$dir/pages/02-二枚目.md"
in_dw cmd_explain --clear
chmod 644 "$dir/pages/02-二枚目.md"
if [ "$code" != 0 ] && grep -q 'nothing was removed' <<< "$out" && [ -z "$(find "$dir/pages" -name 'cleared-*')" ] \
  && [ -f "$dir/pages/01-待つページ.md" ] && [ -f "$dir/pages/02-二枚目.md" ] && [ -f "$DW_HOME/explain/pages/001.md" ]; then
  pass "a clear whose archive cannot hold every page removes nothing, in the record or the panel"
else
  fail "clear with an unreadable page (exit $code: $out): $(ls "$dir/pages" | tr '\n' ' ')"
fi
rm -f "$DW_HOME/record_dir"
rm -rf "$DW_HOME/explain"

dir=$(two_page_record stuck)
printf '1\t準備\n2\t確認\n' > "$dir/pages/sections.tsv"
printf '%s' "$dir" > "$DW_HOME/record_dir"
in_dw cmd_explain "$scratch/waiting.md"
chflags uchg "$dir/pages/02-二枚目.md"
in_dw cmd_explain --clear
# The archive's copy keeps the flag too (cp -p): both go back to normal, or the scratch folder stays
chflags -R nouchg "$dir/pages"
if [ "$code" != 0 ] && grep -q 'could not be removed' <<< "$out" && [ -f "$dir/pages/02-二枚目.md" ] \
  && grep -q 'only part of the record was cleared' <<< "$out" && ! grep -q 'nothing was removed' <<< "$out" \
  && grep -q "$(printf '^2\t確認$')" "$dir/pages/sections.tsv" && [ -f "$DW_HOME/explain/pages/001.md" ]; then
  pass "a page a clear cannot remove keeps its row in sections.tsv, the clear says only part was cleared, and the panel is left as it was"
else
  fail "clear with a page that cannot be removed (exit $code: $out): $(cat "$dir/pages/sections.tsv" | tr '\n' '|')"
fi
rm -f "$DW_HOME/record_dir"
rm -rf "$DW_HOME/explain"

mkdir -p "$scratch/unreadable-skill/explainer" "$DW_HOME/explain/pages"
printf 'x\n' > "$scratch/unreadable-skill/explainer/page.html"
chmod 000 "$scratch/unreadable-skill/explainer/page.html"
printf '{"current":0,"pages":[]}\n' > "$DW_HOME/explain/index.json"
# Run "$@" with dw's SKILL_DIR pointing at another folder (read by dw's functions sourced in in_dw)
# shellcheck disable=SC2034
with_skill_dir() { SKILL_DIR="$1"; shift; "$@"; }
in_dw with_skill_dir "$scratch/unreadable-skill" explain_build 5 "書けないページ" "" "$scratch/body.md" 5
chmod 644 "$scratch/unreadable-skill/explainer/page.html"
if [ "$code" != 0 ] && [ "$(jq '.pages | length' "$DW_HOME/explain/index.json")" = 0 ] && [ ! -e "$DW_HOME/explain/pages/005.html" ]; then
  pass "a page whose HTML cannot be written is not listed in the explainer"
else
  fail "explain_build without its HTML (exit $code: $out): $(cat "$DW_HOME/explain/index.json")"
fi
rm -rf "$DW_HOME/explain"

dir=$(two_page_record explain-error)
printf '%s' "$dir" > "$DW_HOME/record_dir"
printf '# 壊れた\n\n<!-- hud-only -->\n' > "$scratch/broken.md"
in_dw cmd_explain "$scratch/broken.md"
if [ "$code" = 1 ] && grep -q 'HANDOUT_MARKER' <<< "$out" && [ ! -e "$DW_HOME/explain/index.json" ] \
  && [ "$(ls "$dir/pages" | tr '\n' ' ')" = "01-一枚目.md 02-二枚目.md sections.tsv " ]; then
  pass "a marker error from dw explain leaves the panel and the record as they were"
else
  fail "dw explain marker error (exit $code: $out)"
fi
rm -f "$DW_HOME/record_dir"

echo "== audience markers"
printf '本文\r\n<!-- hud-only -->\r\nHUD だけの段落\r\n<!-- /hud-only -->\r\n' > "$scratch/crlf.md"
in_dw explain_filter handout "$scratch/crlf.md" /dev/null
if [ "$code" = 0 ] && grep -q '本文' <<< "$out" && ! grep -q 'HUD だけの段落' <<< "$out"; then
  pass "a page with Windows line endings leaves its hud-only block out of a Handout"
else
  fail "CRLF page (exit $code): $out"
fi

missed=""
for marker in '<!--hud-only-->|<!--/hud-only-->' '<!-- HUD-only -->|<!-- /HUD-only -->' \
  '<!-- hud only -->|<!-- /hud only -->' '本文 <!-- hud-only -->|<!-- /hud-only --> 本文'; do
  printf '%s\n秘密の段落\n%s\n' "${marker%%|*}" "${marker#*|}" > "$scratch/near.md"
  in_dw explain_filter handout "$scratch/near.md" /dev/null
  [ "$code" = 1 ] || missed="$missed [${marker%%|*}]"
done
printf '`<!-- hud-only -->` で囲んだ段落は HUD だけに出ます\n' > "$scratch/spoken.md"
in_dw explain_filter handout "$scratch/spoken.md" /dev/null
if [ -z "$missed" ] && [ "$code" = 0 ]; then
  pass "a marker written another way stops like a marker without its partner; one shown as code does not"
else
  fail "marker written another way: missed$missed, code span exit $code"
fi

printf '```x```\n\n<!-- hud-only -->\nHUD だけの段落\n<!-- /hud-only -->\n' > "$scratch/inline-fence.md"
in_dw explain_filter handout "$scratch/inline-fence.md" /dev/null
if [ "$code" = 0 ] && ! grep -q 'HUD だけの段落' <<< "$out"; then
  pass "a line like \`\`\`x\`\`\` is code in a line, not a fence: the hud-only block after it is still left out"
else
  fail "inline fence (exit $code): $out"
fi

printf -- '- ```bash\n  echo 書き出す\n  ```\n\n<!-- hud-only -->\nHUD だけの段落\n<!-- /hud-only -->\n' > "$scratch/list-fence.md"
in_dw explain_filter handout "$scratch/list-fence.md" /dev/null
if [ "$code" = 0 ] && grep -q 'echo 書き出す' <<< "$out" && ! grep -q 'HUD だけの段落' <<< "$out"; then
  pass "a fence opened on a list item's line closes at its indented fence: the hud-only block after it stays out"
else
  fail "list-item fence (exit $code): $out"
fi

printf '> ```markdown\n> <!-- hud-only -->\n> ```\n\n<!-- hud-only -->\nHUD だけの段落\n<!-- /hud-only -->\n' > "$scratch/quoted-fence.md"
in_dw explain_filter handout "$scratch/quoted-fence.md" /dev/null
if [ "$code" = 0 ] && grep -q '^> <!-- hud-only -->' <<< "$out" && ! grep -q 'HUD だけの段落' <<< "$out"; then
  pass "a quoted fenced example holding a marker is an example, and the block after the quote is still left out"
else
  fail "quoted fence (exit $code): $out"
fi

printf '> ```\n> 引用の中のコード\n引用の外\n<!-- handout-only -->\nHandout だけの段落\n<!-- /handout-only -->\n- ```bash\n  echo 項目の中\nリストの外\n<!-- handout-only -->\nもう一つの段落\n<!-- /handout-only -->\n' > "$scratch/ended-fence.md"
in_dw explain_filter hud "$scratch/ended-fence.md" /dev/null
if [ "$code" = 0 ] && grep -q '引用の外' <<< "$out" && ! grep -q 'Handout だけの段落' <<< "$out" && ! grep -q 'もう一つの段落' <<< "$out"; then
  pass "a fence ends where its quote or list item ends: the audience blocks after it are read"
else
  fail "fence that ends with its container (exit $code): $out"
fi

printf '記法は `` <!-- hud-only --> `` のとおり\n' > "$scratch/double-tick.md"
in_dw explain_filter handout "$scratch/double-tick.md" /dev/null
if [ "$code" = 0 ] && grep -q '記法は' <<< "$out"; then
  pass "a marker inside a double-backtick code span is an example, not a marker written another way"
else
  fail "double-backtick code span (exit $code): $out"
fi

printf '<!-- handout-only -->\nHUD の右上を押します\n<!-- /handout-only -->\n' > "$scratch/worded.md"
: > "$scratch/worded.problems"
in_dw explain_filter handout "$scratch/worded.md" "$scratch/worded.problems"
if grep -q "$(printf '^warning\t2\tHUD$')" "$scratch/worded.problems"; then
  pass "HUD wording inside a handout-only block gives a warning"
else
  fail "HUD wording in handout-only: $(cat "$scratch/worded.problems")"
fi

dir="$RECORDS/hud-title"
mkdir -p "$dir/pages"
printf '<!-- hud-only -->\n# HUD だけの見出し\n<!-- /hud-only -->\n\n本文\n' > "$dir/pages/01-HUD-だけの見出し.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
in_dw record_title "$dir" 1 "$dir/pages/01-HUD-だけの見出し.md" handout
if [ "$out" = "解説 1" ]; then
  pass "a page whose only heading is hud-only is titled by its number in a Handout, not by its file name"
else
  fail "hud-only heading title: $out"
fi

echo "== dw handout, before the renderer"
dir=$(two_page_record unreadable)
chmod 000 "$dir/pages/02-二枚目.md"
rm -f "$DW_CHECK_SEEN"
in_dw cmd_handout unreadable
chmod 644 "$dir/pages/02-二枚目.md"
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "a page that cannot be read stops the export (HANDOUT_RECORD) before the renderer starts"
else
  fail "unreadable page (exit $code): $out"
fi

# A sections.tsv that exists but cannot be read would drop every section and title: the export stops
dir=$(two_page_record unreadable-sections)
printf '1\t準備\t一枚目\n' > "$dir/pages/sections.tsv"
chmod 000 "$dir/pages/sections.tsv"
