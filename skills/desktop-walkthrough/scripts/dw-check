kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD.*being written by another dw' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "an export waits for a page being written (the record's lock), then stops before the renderer starts"
