in_dw cmd_handout unreadable-sections
chmod 644 "$dir/pages/sections.tsv"
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD.*sections.tsv could not be read' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "a sections.tsv that cannot be read stops the export (HANDOUT_RECORD) rather than losing every section"
else
  fail "unreadable sections.tsv (exit $code): $out"
fi

dir=$(two_page_record duplicate)
printf '# 別の二枚目\n' > "$dir/pages/02-別の二枚目.md"
rm -f "$DW_CHECK_SEEN"
in_dw cmd_handout duplicate
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD.*page 2' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "two files for one page number stop the export (HANDOUT_RECORD)"
else
  fail "duplicate page numbers (exit $code): $out"
fi

dir=$(two_page_record labelled)
mv "$dir/pages/02-二枚目.md" "$dir/pages/02-題に書いた値.md"
printf '\n<!-- hud-only -->\n閉じ忘れ\n' >> "$dir/pages/02-題に書いた値.md"
in_dw cmd_handout labelled
if [ "$code" = 1 ] && grep -q 'HANDOUT_MARKER page 2:5: <!-- hud-only --> is never closed' <<< "$out" && ! grep -q '題に書いた値' <<< "$out"; then
  pass "a marker error names the page by its number, never by its file name (made from its title)"
else
  fail "marker error label (exit $code): $out"
fi

# Where mktemp makes scratch folders (macOS's does not follow TMPDIR): a stopped export must leave no
# copy of a page there. The page carries a marker of this run, so only this run's copies are looked for
temp_root=$(dirname "$(mktemp -u)")
marker="dw-check-leftover-$$-$RANDOM"
dir=$(two_page_record leftovers)
printf '%s\n' "$marker" >> "$dir/pages/01-一枚目.md"
in_dw cmd_handout leftovers
printf '\n<!-- hud-only -->\n' >> "$dir/pages/01-一枚目.md"
in_dw cmd_handout leftovers
left=$(grep -rl "$marker" "$temp_root"/tmp.*/source 2>/dev/null)
if [ "$code" = 1 ] && [ -z "$left" ]; then
  pass "a stopped export leaves no scratch folder (with copies of the pages) behind"
else
  fail "scratch folders left (exit $code): $(printf '%s' "$left" | tr '\n' ' ')"
  # Only the copies of this run's synthetic page go (one path per line), never a folder around them
  while IFS= read -r copy; do [ -n "$copy" ] && rm -f -- "$copy"; done <<< "$left"
fi

dir="$RECORDS/race"
mkdir -p "$dir/pages"
printf '# 記録：race\n' > "$dir/journal.md"
printf '# 競合\n\nAAAA\n' > "$dir/pages/01-競合.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
cp -p "$dir/pages/01-競合.md" "$scratch/race-reference"
# A writer saves another version of the page, the same size within the same second, right after dw built it
racing_build() {
  eval "original_$(declare -f explain_build)"
  explain_build() {
    original_explain_build "$@"
    local status=$?
    printf '# 競合\n\nBBBB\n' > "$RECORDS/race/pages/01-競合.md"
    touch -r "$scratch/race-reference" "$RECORDS/race/pages/01-競合.md"
    return "$status"
  }
  "$@"
}
rm -f "$DW_CHECK_SEEN"
in_dw racing_build cmd_handout race
if grep -q 'AAAA' <<< "$(jq -r '.pages[0].markdown' "$DW_CHECK_SEEN" 2>/dev/null)"; then
  pass "the secret scan reads the very copy of a page that was built, however the page changes meanwhile"
else
  fail "one read per page (exit $code): scanned $(jq -r '.pages[0].markdown' "$DW_CHECK_SEEN" 2>/dev/null | tr '\n' ' ')"
fi

dir=$(two_page_record doubled)
# A writer adds a second file for page 2 while dw builds the pages: the reading after that sees it
doubling_build() {
  eval "original_$(declare -f explain_build)"
  explain_build() {
    original_explain_build "$@"
    local status=$?
    [ -e "$RECORDS/doubled/pages/02-別の二枚目.md" ] || printf '# 別の二枚目\n' > "$RECORDS/doubled/pages/02-別の二枚目.md"
    return "$status"
  }
  "$@"
}
rm -f "$DW_CHECK_SEEN"
in_dw doubling_build cmd_handout doubled
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD.*page 2' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "a second file for a page number that appears while the pages are read stops the export on that reading"
else
  fail "duplicate during the reading (exit $code: $out)"
fi

dir="$RECORDS/renamed"
mkdir -p "$dir/pages"
printf '# 記録：renamed\n' > "$dir/journal.md"
printf '# 置換\n\nAAAA\n' > "$dir/pages/01-置換.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
cp -p "$dir/pages/01-置換.md" "$scratch/renamed-reference"
# A writer saves another version as dw does (a new file renamed over the page): same size, same second
renaming_build() {
  eval "original_$(declare -f explain_build)"
  explain_build() {
    original_explain_build "$@"
    local status=$?
    if [ ! -e "$scratch/renamed-done" ]; then
      printf '# 置換\n\nBBBB\n' > "$scratch/renamed-new.md"
      touch -r "$scratch/renamed-reference" "$scratch/renamed-new.md"
      mv "$scratch/renamed-new.md" "$RECORDS/renamed/pages/01-置換.md"
      : > "$scratch/renamed-done"
    fi
    return "$status"
  }
  "$@"
}
rm -f "$DW_CHECK_SEEN"
in_dw renaming_build cmd_handout renamed
if grep -q 'reading them again' <<< "$out" && grep -q 'BBBB' <<< "$(jq -r '.pages[0].markdown' "$DW_CHECK_SEEN" 2>/dev/null)"; then
  pass "a page replaced by a same-size save within the same second is read again (the listing knows each file)"
else
  fail "same-size replacement (exit $code: $out): $(jq -r '.pages[0].markdown' "$DW_CHECK_SEEN" 2>/dev/null | tr '\n' ' ')"
fi

cat > "$scratch/escaping-renderer" <<'EOF'
#!/bin/bash
printf '{"v":1,"ok":false,"diagnostics":[{"code":"HANDOUT_IMAGE","message":"page 1:3: the image \\u001b]0;title\\u0007x.png is not an image"}],"log":"/tmp/x"}'
EOF
chmod +x "$scratch/escaping-renderer"
dir=$(two_page_record escaped)
renderer="$scratch/escaping-renderer"
in_dw cmd_handout escaped
renderer="$scratch/fake-renderer"
if [ "$code" = 1 ] && grep -q 'HANDOUT_IMAGE page 1:3: the image \]0;titlex.png is not an image' <<< "$out" && ! grep -q $'[\033\007]' <<< "$out"; then
  pass "the renderer's messages reach the terminal without control characters"
else
  fail "control characters from the renderer (exit $code): $(printf '%s' "$out" | od -c | head -5)"
fi

dir=$(two_page_record retried)
printf '# 書き換え中\n' > "$dir/pages/02-書き換え中.md"
rm -f "$scratch/record-pages-calls"
# The second listing (the first reading's) still sees the page being rewritten; the next one does not
retrying_lists() {
  eval "original_$(declare -f record_pages)"
  record_pages() {
    original_record_pages "$@"
    local calls
    calls=$(($(cat "$scratch/record-pages-calls" 2>/dev/null || echo 0) + 1))
    echo "$calls" > "$scratch/record-pages-calls"
    [ "$calls" = 2 ] && rm -f "$RECORDS/retried/pages/02-書き換え中.md"
    return 0
  }
  "$@"
}
rm -f "$DW_CHECK_SEEN"
in_dw retrying_lists cmd_handout retried
if grep -q 'reading the pages again' <<< "$out" && [ "$(jq '.pages | length' "$DW_CHECK_SEEN" 2>/dev/null)" = 2 ]; then
  pass "two files for a page number seen once (a page being rewritten) are read again, not refused"
else
  fail "duplicate on the first reading (exit $code: $out)"
fi

dir="$RECORDS/restless"
mkdir -p "$dir/pages"
printf '# 記録：restless\n' > "$dir/journal.md"
printf '# 揺れる\n\n本文\n' > "$dir/pages/01-揺れる.md"
printf '1\t\n' > "$dir/pages/sections.tsv"
# A writer saves the page again after every build: neither reading holds still
restless_build() {
  eval "original_$(declare -f explain_build)"
  explain_build() {
    original_explain_build "$@"
    local status=$?
    printf '# 揺れる\n\n本文 %s\n' "$RANDOM" > "$scratch/restless.md" && mv "$scratch/restless.md" "$RECORDS/restless/pages/01-揺れる.md"
    return "$status"
  }
  "$@"
}
rm -f "$DW_CHECK_SEEN"
in_dw restless_build cmd_handout restless
if [ "$code" = 1 ] && grep -q 'changed while they were read, twice' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "pages that change during both readings stop the export (HANDOUT_RECORD) before the renderer starts"
else
  fail "restless pages (exit $code: $out)"
fi

dir=$(two_page_record broken-name)
printf '# 改行\n' > "$dir/pages/03-改"$'\n'"行.md"
rm -f "$DW_CHECK_SEEN"
in_dw cmd_handout broken-name
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD.*line break' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "a page file with a line break in its name stops the export (HANDOUT_RECORD): it would split every list"
else
  fail "line break in a page's file name (exit $code: $out)"
fi

# An entry that is no page file is looked for with every list of the pages the export takes, not only
# at its start: one put there while the export waits for the record's lock is in no list it compares
dir=$(two_page_record odd-snapshot)
rm -f "$DW_CHECK_SEEN"
holder=$(hold_then_leave_link "$dir/pages/.dw-lock" "$dir/pages/03-後から.md")
in_dw cmd_handout odd-snapshot
wait "$holder" 2>/dev/null
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD page 3 of odd-snapshot is a link whose file is gone' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "an entry that is no page file, put there after the export's first look, stops it when the pages are listed"
else
  fail "odd entry after the export's first look (exit $code: $out)"
fi
# The same for one put there while the pages are read: the list taken afterwards would leave it out too
dir=$(two_page_record odd-reading)
rm -f "$DW_CHECK_SEEN"
DW_CHECK_LINK="$dir/pages/03-後から.md" in_dw link_while_reading cmd_handout odd-reading
if [ "$code" = 1 ] && grep -q 'HANDOUT_RECORD page 3 of odd-reading is a link whose file is gone' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "an entry that is no page file, put there while the export reads the pages, stops it before the renderer starts"
else
  fail "odd entry while the export reads the pages (exit $code: $out)"
fi

in_dw cmd_handout ../escape
if [ "$code" = 1 ] && grep -q 'plain folder name' <<< "$out"; then
  pass "a record name with a slash or a leading dot is refused before anything is read"
else
