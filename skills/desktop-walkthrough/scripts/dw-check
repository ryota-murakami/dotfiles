mkdir -p "$DW_HOME/explain/vendor"
printf 'changed\n' > "$DW_HOME/explain/vendor/lib.js"
vendor_list="lib.js|https://cdn.test/lib.js|$(printf 'expected\n' | shasum -a 256 | cut -d' ' -f1)"
rm -f "$DW_CHECK_SEEN"
in_dw cmd_handout vendored
vendor_list=""
rm -rf "$DW_HOME/explain"
if [ "$code" = 1 ] && grep -q 'HANDOUT_VENDOR lib.js' <<< "$out" && [ ! -e "$DW_CHECK_SEEN" ]; then
  pass "a library that is not the version dw expects stops the export (HANDOUT_VENDOR) before the renderer starts"
