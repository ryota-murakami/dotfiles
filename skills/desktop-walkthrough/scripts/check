#!/bin/bash
# check — static checks for the desktop-walkthrough skill; run before saving or committing it.
#
# Why it exists: mechanical slips came back during real runs (bash 3.2 "unbound variable" after a
# variable followed by a multibyte character, twice; the hooks module type-checked a different way
# each time). save-my-skill's save.sh runs this file whenever a skill ships one.
#
# Usage: scripts/check   exit 0 when every check passed; a missing optional tool is reported and skipped
set -u
cd "$(dirname "$0")/.." || exit 1
failed=""

# Run one named check; remember its name when it fails
run() {
  local name="$1"
  shift
  printf '== %s\n' "$name"
  "$@" || failed="$failed
  - $name"
}

# The scripts parse under macOS /bin/bash 3.2
bash_syntax() {
  /bin/bash -n scripts/dw && /bin/bash -n scripts/check && /bin/bash -n scripts/typecheck-hooks && /bin/bash -n scripts/hud-golden \
    && /bin/bash -n scripts/handout-check && /bin/bash -n scripts/dw-check
}

# bash 3.2 reads "$name（" as a longer variable name and stops with "unbound variable": brace it
multibyte_after_variable() {
  perl -ne 'if (!/^\s*#/ && /\$[A-Za-z_][A-Za-z0-9_]*[^\x00-\x7F]/) { print "$ARGV:$.: $_"; $hit = 1 } close ARGV if eof; END { exit($hit ? 1 : 0) }' scripts/dw scripts/check scripts/hud-golden scripts/handout-check scripts/dw-check
}

# Manifest and hooks module as the engine reads them; only problems are printed
validate_plugin() {
  local out status
  out=$(claude plugin validate . 2>&1)
  status=$?
  printf '%s\n' "$out" | grep -E '✘|[Ee]rror' || true
  return $status
}

# The workspace's own checks: lint, formatting, and each package's types, tests and build. The
# bridge is left out here: its tests and types run below without Node dependencies
workspace() {
  pnpm lint && pnpm format:check && pnpm exec turbo run typecheck test build --filter='!@dw/bridge'
}

# The committed builds are what their sources build (eng D4): the HUD and dw load packages/*/dist as
# committed, so a fix in a source that was never rebuilt would never run. Runs after the workspace build
committed_builds() {
  local changed
  # A pathspec git expands, not the shell: a build folder that is gone entirely is matched too
  changed=$(git status --porcelain -- ':(glob)packages/*/dist/**')
  [ -z "$changed" ] && return 0
  printf '%s\n' "$changed"
  echo "the committed build differs from a fresh one: commit packages/<name>/dist with its source (pnpm build rebuilds it)"
  return 1
}

# dw handout's stable codes are one list (A5): the contract's enum, the code-to-fix table in SKILL.md
# and every code dw, the renderer and the builder raise; and the Handout marker is one literal
handout_contract() {
  local enum table used status=0
  enum=$(sed -n "/^export const handoutCodeSchema = z.enum(\[/,/^\])/p" packages/handout/src/contract.ts | grep -o 'HANDOUT_[A-Z_]*' | sort -u)
  table=$(grep -o '^| `HANDOUT_[A-Z_]*`' SKILL.md | grep -o 'HANDOUT_[A-Z_]*' | sort -u)
  used=$(cat scripts/dw handout/main.swift packages/handout/src/builder/*.ts | grep -o 'HANDOUT_[A-Z][A-Z0-9_]*' \
    | grep -v -x -e HANDOUT_DOM -e HANDOUT_HEAD -e HANDOUT_PROTOCOL_VERSION \
      -e HANDOUT_HUD_WORDS -e HANDOUT_BIN -e HANDOUT_DIST -e HANDOUT_PAGE_LIMIT_MS -e HANDOUT_RUN_LIMIT_MS \
      -e HANDOUT_CONTROLLER_SOURCE -e HANDOUT_CONTROLLER_SHA256 | sort -u)
  if [ "$enum" != "$table" ]; then
    echo "SKILL.md's code table and contract.ts differ:"; diff <(printf '%s\n' "$enum") <(printf '%s\n' "$table"); status=1
  fi
  if [ -n "$(comm -23 <(printf '%s\n' "$used") <(printf '%s\n' "$enum"))" ]; then
    echo "codes raised but not in contract.ts: $(comm -23 <(printf '%s\n' "$used") <(printf '%s\n' "$enum") | tr '\n' ' ')"; status=1
  fi
  # The time limits (eng D3): dw sets them on every export, the contract names them
  local page_dw run_dw page_ts run_ts
  page_dw=$(sed -n 's/^HANDOUT_PAGE_LIMIT_MS=\([0-9]*\)$/\1/p' scripts/dw)
  run_dw=$(sed -n 's/^HANDOUT_RUN_LIMIT_MS=\([0-9]*\)$/\1/p' scripts/dw)
  page_ts=$(sed -n 's/^export const PAGE_RENDER_LIMIT_MS = \([0-9_]*\)$/\1/p' packages/handout/src/constants.ts | tr -d _)
  run_ts=$(sed -n 's/^export const RUN_LIMIT_MS = \([0-9_]*\)$/\1/p' packages/handout/src/constants.ts | tr -d _)
  if [ -z "$page_dw" ] || [ "$page_dw" != "$page_ts" ] || [ "$run_dw" != "$run_ts" ]; then
    echo "the time limits differ between scripts/dw (page $page_dw, run $run_dw) and constants.ts (page $page_ts, run $run_ts)"
    status=1
  fi
  # The first bytes of a Handout, as each side writes or requires them: one string, byte for byte
  local head_ts head_swift head_dw
  head_ts=$(sed -n "/^export const HANDOUT_HEAD =/,/'\$/p" packages/handout/src/contract.ts | tail -1 | sed "s/^ *'//; s/'\$//")
  head_swift=$(sed -n 's/^let handoutHead = "\(.*\)"$/\1/p' handout/main.swift | sed 's/\\"/"/g')
  head_dw=$(sed -n "/^HANDOUT_HEAD='/,/'\$/p" scripts/dw | sed "1s/^HANDOUT_HEAD='//; \$s/'\$//")
  if [ -z "$head_dw" ] || [ "$(printf '%b' "$head_ts")" != "$head_dw" ] || [ "$(printf '%b' "$head_swift")" != "$head_dw" ]; then
    echo "the Handout head differs between contract.ts, main.swift and dw:"
    printf '  contract.ts: %s\n  main.swift:  %s\n  dw:          %s\n' "$head_ts" "$head_swift" "$(printf '%s' "$head_dw" | tr '\n' '|')"
    status=1
  fi
  return $status
}

# The inline scripts of the page templates parse (a template is only run inside the HUD's web views)
page_scripts() {
  local tmp status=0 file
  tmp=$(mktemp -d)
  python3 -I - "$tmp" explainer/*.html <<'PY' || { rm -rf "$tmp"; return 1; }
import re, sys, pathlib
out = pathlib.Path(sys.argv[1])
for path in sys.argv[2:]:
    text = pathlib.Path(path).read_text()
    # Scripts with a src are libraries, and a type other than JavaScript is data
    for i, match in enumerate(re.finditer(r"<script(?P<attrs>[^>]*)>(?P<body>.*?)</script>", text, re.S)):
        if "src=" in match.group("attrs") or "type=" in match.group("attrs"):
            continue
        (out / f"{pathlib.Path(path).stem}-{i}.js").write_text(match.group("body"))
PY
  for file in "$tmp"/*.js; do
    [ -f "$file" ] || continue
    node --check "$file" || status=1
  done
  rm -rf "$tmp"
  return $status
}

run "bash syntax (/bin/bash 3.2)" bash_syntax
if command -v shellcheck >/dev/null 2>&1; then
  run "shellcheck" shellcheck -S warning scripts/dw scripts/check scripts/typecheck-hooks scripts/hud-golden scripts/handout-check scripts/dw-check
else
  echo "== shellcheck: skipped (brew install shellcheck)"
fi
run "bash 3.2: brace a variable followed by a multibyte character" multibyte_after_variable
run "HUD: swiftc -typecheck" swiftc -typecheck hud/*.swift
run "Handout renderer: swiftc -typecheck" swiftc -typecheck handout/*.swift
run "Handout: codes, SKILL.md table and marker agree" handout_contract
if command -v python3 >/dev/null 2>&1; then
  run "sounds: synth.py parses" python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' sounds/synth.py
  if command -v node >/dev/null 2>&1; then
    run "page templates: inline scripts parse" page_scripts
  else
    echo "== page templates: skipped (node is not installed)"
  fi
else
  echo "== sounds and page templates: skipped (python3 is not installed)"
fi
if command -v claude >/dev/null 2>&1; then
  run "plugin: claude plugin validate" validate_plugin
  run "hooks tests: claude plugin test" claude plugin test .
else
  echo "== claude CLI not found: plugin validate and tests skipped"
fi
run "hooks types: tsc" scripts/typecheck-hooks
if [ -d node_modules ] && command -v pnpm >/dev/null 2>&1; then
  run "workspace: lint, formatting, types, tests, build" workspace
  run "committed builds match their sources (packages/*/dist)" committed_builds
else
  echo "== workspace: skipped (run 'pnpm install' in this folder first)"
fi
# dw's plumbing, function by function (BSD stat and date: macOS)
if [ "$(uname)" = Darwin ] && command -v jq >/dev/null 2>&1; then
  run "dw: narration, records, resume, markers and the checks before the renderer" scripts/dw-check
else
  echo "== dw plumbing cases: skipped (they need macOS and jq)"
fi
# WebKit lays out only for the user logged in at the screen: elsewhere (CI, another user over ssh) the renderer cannot run
if [ "$(uname)" = Darwin ] && [ "$(stat -f %Su /dev/console 2>/dev/null)" = "$(id -un)" ] && command -v jq >/dev/null 2>&1; then
  run "dw handout: renderer cases and the HUD golden" scripts/handout-check
else
  echo "== dw handout renderer cases and HUD golden: skipped (they need a logged-in macOS session and jq)"
fi

if [ -n "$failed" ]; then
  printf '✗ failed:%s\n' "$failed"
  exit 1
fi
echo "✓ all checks passed"
