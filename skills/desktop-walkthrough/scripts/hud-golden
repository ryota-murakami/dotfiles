#!/bin/bash
# hud-golden — the HUD Explainer's regression baseline (eng review D5).
#
# Why it exists: `dw handout` adds a Handout mode to explainer/page.html and audience markers to
# explain_build, and every HUD page goes through both. The baseline is the fixture Record's pages as
# dw built them before that change; a scripts/check step renders the baseline and a fresh HUD build of
# the same pages through the Handout renderer in HUD mode and requires the same #content, the same
# reading-mark blocks and the same render report.
#
# Usage: scripts/hud-golden capture   rebuild fixtures/hud-golden/baseline with the current dw and
#                                     page.html; run it only when a change to HUD rendering is intended
set -u
cd "$(dirname "$0")/.." || exit 1
SKILL_DIR=$(pwd)
GOLDEN="$SKILL_DIR/fixtures/hud-golden"

# Build every fixture page with dw's own explain_build into the baseline folder
capture() {
  local tmp EXPLAIN page base n title step count=0
  tmp=$(mktemp -d)
  EXPLAIN="$tmp/explain"
  mkdir -p "$EXPLAIN/pages"
  printf '{"current":0,"pages":[]}\n' > "$EXPLAIN/index.json"
  # explain_build exactly as dw defines it: the baseline is what dw builds, not a copy of that code.
  # It reads EXPLAIN and SKILL_DIR, which it sees from here
  eval "$(sed -n '/^explain_build() {$/,/^}$/p' scripts/dw)"
  # Title and section as dw resume finds them: the first H1, the page's row in sections.tsv
  for page in "$GOLDEN"/record/pages/[0-9]*-*.md; do
    [ -f "$page" ] || continue
    base=$(basename "$page" .md)
    n=$((10#${base%%-*}))
    title=$(sed -n 's/^# \{1,\}//p' "$page" | head -1)
    step=$(awk -F '\t' -v n="$n" '$1 == n { print $2 }' "$GOLDEN/record/pages/sections.tsv")
    explain_build "$n" "$title" "$step" "$page" "$n"
    count=$((count + 1))
  done
  [ "$count" -gt 0 ] || { echo "hud-golden: no fixture pages in $GOLDEN/record/pages" >&2; rm -rf "$tmp"; return 1; }
  rm -rf "$GOLDEN/baseline"
  mkdir -p "$GOLDEN/baseline/pages"
  cp "$EXPLAIN"/pages/[0-9]*.html "$GOLDEN/baseline/pages/"
  rm -rf "$tmp"
  echo "hud-golden: $count page(s) built into fixtures/hud-golden/baseline/pages"
}

case "${1:-}" in
  capture) capture ;;
  *)       awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2 ;;
esac
