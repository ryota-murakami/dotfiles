# =============================================================================
# Shared Shell Functions for bash/zsh
# =============================================================================
# This file is sourced by both .bashrc and .zshrc
# Fish shell handles functions separately in .config/fish/functions/
#
# Philosophy:
# - Essential utility functions available in all POSIX-compatible shells
# - Mirrors Fish functions where applicable for consistency

# =============================================================================
# kill-port - Kill Processes on a Specific Port
# =============================================================================
#
# DESCRIPTION:
#   Forcefully terminates all processes listening on a specified port.
#   Essential for development when a port is stuck (e.g., crashed server,
#   orphaned process from previous session).
#
# USAGE:
#   kill-port <port>
#
# ARGUMENTS:
#   port - Port number to free (e.g., 3000, 8080)
#
# HOW IT WORKS:
#   1. Uses lsof to find process IDs using the port
#   2. Pipes PIDs to kill -9 for forceful termination
#   3. Reports success
#
# DEPENDENCIES:
#   - lsof (pre-installed on macOS)
#   - xargs (pre-installed on macOS)
#
# EXAMPLE:
#   $ kill-port 3000
#   Killed processes on port 3000
#
# =============================================================================
kill-port() {
    if [ -z "$1" ]; then
        echo "Usage: kill-port <port>"
        echo "Example: kill-port 3000"
        return 1
    fi
    lsof -ti :"$1" | xargs kill -9 2>/dev/null
    echo "Killed processes on port $1"
}


# =============================================================================
# sfw - Toggle Socket Firewall package manager wrapping
# =============================================================================
#
# DESCRIPTION:
#   Wraps the real `sfw` binary. Intercepts `on`, `off`, `toggle`, `status`
#   to enable/disable the package manager aliases defined in ~/.aliases-sfw
#   (synchronized with fish conf.d/21-sfw.fish). All other arguments are
#   passed through to the real sfw binary.
#
# USAGE:
#   sfw on       Enable sfw wrapping (npm, pnpm, pip, cargo, ... route via sfw)
#   sfw off      Disable sfw wrapping (package managers run directly)
#   sfw toggle   Flip the current state
#   sfw status   Show current state
#   sfw <args>   Forward to the real sfw binary (e.g. `sfw npm install`)
#
# STATE:
#   ~/.sfw-disabled - flag file; present = OFF, absent = ON (fail-safe ON).
#   New shells pick up the state via the guard in ~/.aliases-sfw.
#   The sfw binary remains directly usable even when wrapping is OFF.
#
# =============================================================================
sfw() {
    local flag="$HOME/.sfw-disabled"
    case "$1" in
        on)
            # Clear flag first so the guard in .aliases-sfw re-creates aliases
            rm -f "$flag"
            [ -f "$HOME/.aliases-sfw" ] && . "$HOME/.aliases-sfw"
            echo "✓ sfw wrapping enabled (npm, pnpm, pip, ... route via sfw)"
            ;;
        off)
            touch "$flag"
            unalias npm npx pnpm pnpx yarn bun pip pip3 uv cargo 2>/dev/null
            echo "✓ sfw wrapping disabled (npm, pnpm, pip, ... run directly)"
            ;;
        toggle)
            if [ -f "$flag" ]; then sfw on; else sfw off; fi
            ;;
        status)
            if [ -f "$flag" ]; then echo "sfw wrapping: OFF"; else echo "sfw wrapping: ON"; fi
            ;;
        *)
            command sfw "$@"
            ;;
    esac
}
