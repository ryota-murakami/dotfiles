# Deny by default: ~/.config is a link to this folder, tools create new folders in it all the time,
# and this repository is public. Track a tool's folder by adding a `!/<name>/` line below.
/*
!/.gitignore
!/blest/
!/btop/
!/fish/
!/gh/
!/ghostty/
!/git/
!/karabiner/
!/key/
!/yazi/

# Machine-specific or secret files inside the tracked folders
btop/btop.log
gh/hosts.yml
credentials.json
