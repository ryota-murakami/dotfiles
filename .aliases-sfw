# =============================================================================
# Socket Firewall (sfw) - Package manager aliases
# =============================================================================
# Routes package manager commands through sfw for supply chain protection.
# Install: npm install -g sfw
# Docs: https://docs.socket.dev/docs/socket-firewall-free
# Toggle wrapping on/off with `sfw on|off|toggle` (state: ~/.sfw-disabled)

# Skip when wrapping is disabled via `sfw off`
if [ ! -f "$HOME/.sfw-disabled" ]; then
    # JavaScript/TypeScript
    alias npm="sfw npm"
    alias npx="sfw npx"
    alias pnpm="sfw pnpm"
    alias pnpx="sfw pnpx"
    alias yarn="sfw yarn"
    alias bun="sfw bun"

    # Python
    alias pip="sfw pip"
    alias pip3="sfw pip3"
    alias uv="sfw uv"

    # Rust
    alias cargo="sfw cargo"
fi
